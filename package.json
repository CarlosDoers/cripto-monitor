{
  "name": "cripto-monitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vitest run && vite build && node scripts/build-mcp.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "candles": "node scripts/fetch-candles.mjs",
    "audit": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/audit-strategies.mjs",
    "orb": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/orb-research.mjs",
    "levels": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/levels-research.mjs",
    "levels:sweep": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/levels-sweep.mjs",
    "try": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/try-strategy.mjs",
    "trendlines": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/trendlines-research.mjs",
    "ma": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/ma-research.mjs",
    "smc": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/smc-research.mjs",
    "screener": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/screener-research.mjs",
    "lookahead": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/lookahead-check.mjs",
    "funding:fetch": "node scripts/fetch-funding.mjs",
    "emasweep": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/ema-sweep.mjs",
    "ematouch": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/ema-touch-research.mjs",
    "funding": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/funding-research.mjs",
    "battery": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/battery.mjs",
    "ideas": "node --experimental-strip-types --import ./scripts/_hook.mjs scripts/ideas-research.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@vercel/blob": "^2.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.3"
  }
}
