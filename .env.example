# ---------------------------------------------------------------------------
# Credenciales de OKX  —  NUNCA uses el prefijo VITE_ aquí.
#
# Las variables VITE_* se incrustan en el JavaScript que descarga el navegador:
# cualquiera podría leer tu secret key. Estas tres las lee solo la función
# serverless en api/, que se ejecuta en el servidor.
#
# Cópialo a `.env.local` para desarrollo (ese archivo está en .gitignore).
# En producción se definen en el panel de Vercel, no en un archivo.
# ---------------------------------------------------------------------------

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ---------------------------------------------------------------------------
# Contraseña de acceso a la app (MUY recomendada en producción).
#
# Tu URL de Vercel es pública. Sin esto, cualquiera que la encuentre ve tu
# cartera. Genera una con:  openssl rand -base64 32
# Si la dejas vacía, la app no pide contraseña (cómodo solo en local).
# ---------------------------------------------------------------------------

APP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------

# Dominio de la API. Cambia esto si tu cuenta está en una entidad regional:
#   Global    https://www.okx.com        (por defecto)
#   Europa    https://eea.okx.com
#   EE.UU.    https://app.okx.com
# Si recibes errores de autenticación con las claves correctas, casi siempre
# es que estás apuntando al dominio equivocado.
OKX_BASE_URL=https://www.okx.com

# Pon 1 para usar la cuenta de trading en modo demo (simulated trading).
OKX_SIMULATED=
